{
  "name": "nemo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NEMO — an AI visual teacher that draws its explanations live on a black infinite canvas.",
  "scripts": {
    "dev": "vite",
    "api": "node server/standalone.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser/verify.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
