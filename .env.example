# NEMO — environment configuration
#
# Every value here is OPTIONAL. Keys can instead be typed into the config panel
# in the top-right of the running app, which sends them to the local backend per
# request. Nothing in this file is ever bundled into the browser client.
#
# Copy to `.env` and fill in what you have:
#     cp .env.example .env

# ---------------------------------------------------------------- AI provider

# Which provider the backend uses when the browser does not specify one.
# One of: zai | openrouter | gemini | mock
NEMO_PROVIDER=zai

# Z.AI — the primary provider.
# Get a key at https://z.ai (Open Platform → API keys).
ZAI_API_KEY=
# Model id, e.g. glm-4.6 or glm-4.5-air
ZAI_MODEL=glm-4.6
# Only set this if your account uses a non-default endpoint.
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# OpenRouter — alternate provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Google Gemini — alternate provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --------------------------------------------------------------------- voice

# ElevenLabs is the only narration provider. With no key, lessons run silently
# and the UI shows VOICE UNAVAILABLE — browser speech synthesis is never used.
ELEVENLABS_API_KEY=
# Defaults to the "Rachel" voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# -------------------------------------------------------------------- server

# Port for the standalone API (`npm run api`). Not needed for `npm run dev`,
# which mounts the backend inside Vite on port 5173.
PORT=8787
# NEMO_CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------ agent workflow

# Which orchestrator handles a lesson request.
#   langgraph (default) — the agent graph: solver, teaching director, visual
#                         planner, composer, critic and repair
#   legacy              — the original linear pipeline, kept as a fallback
# NEMO_WORKFLOW=langgraph

# Hard ceiling on critic -> repair -> re-render cycles. Never unbounded.
VISUAL_REPAIR_MAX_ITERATIONS=2

# Set to 0 to run the Visual Critic on deterministic scene measurements only
# (overlap, clipping, off-screen, unreadable size) without calling a vision
# model. Useful when the configured model has no vision support.
# NEMO_VISION_CRITIC=1

# Per-attempt model retry budget, and the backoff envelope.
MODEL_MAX_RETRIES=3
# MODEL_RETRY_BASE_MS=400
# MODEL_RETRY_MAX_MS=4000

# Optional fallback, tried only after the primary provider is exhausted.
# Every use is recorded in the workflow trace; it is never a silent swap.
# MODEL_FALLBACK_PROVIDER=openrouter
# MODEL_FALLBACK_MODEL=anthropic/claude-sonnet-4

# Whole-render budget for one ManimGL pass.
MANIMGL_TIMEOUT_MS=240000

# Print the per-stage workflow trace and retain truncated raw model output for
# diagnosis. Never logs API keys. Off in normal operation.
# NEMO_DEBUG=1
